{
  "name": "take-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently -k -n next,trigger -c blue,magenta \"next dev\" \"trigger dev\"",
    "dev:web": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --var DESIGN_GALLERY:1",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "auth generate --config src/server/auth.cli.ts --output src/db/schema/auth.ts --yes",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "pnpm run deploy:check-env && opennextjs-cloudflare build && pnpm run deploy:check-maps && bash scripts/deploy-worker.sh production ${SENTRY_RELEASE:-unknown}",
    "deploy:check-env": "if ls -a | grep -E '^\\.(env|dev\\.vars)' | grep -vx '.env.example' | grep -q .; then echo 'Refusing to deploy: OpenNext would bake local .env or .dev.vars values into the production Worker. Build from a clean checkout.' >&2; exit 1; fi",
    "deploy:check-maps": "if find .open-next/assets -name '*.map' | grep -q .; then echo 'Refusing to deploy: source maps in .open-next/assets would be served publicly (spec 0005, AC-6).' >&2; exit 1; fi",
    "deploy:trigger": "trigger deploy",
    "prepare": "[ -n \"$CI\" ] || { h=$(git rev-parse --git-path hooks/pre-commit 2>/dev/null); if [ -f \"$h\" ] && ! grep -q SIMPLE_GIT_HOOKS \"$h\"; then echo \"prepare: kept your own pre-commit hook at $h, so the lint-staged hook was not installed (see README).\" >&2; else simple-git-hooks; fi; }",
    "r2:cors": "tsx scripts/r2-cors.ts",
    "test:pipeline": "tsx tests/pipeline/run.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@sentry/core": "11.12.0",
    "@sentry/nextjs": "11.12.0",
    "@sentry/node": "11.12.0",
    "@trigger.dev/sdk": "4.8.3",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@sentry/cli": "3.8.2",
    "@sentry/esbuild-plugin": "11.12.0",
    "@tailwindcss/postcss": "4.3.5",
    "@trigger.dev/build": "4.8.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.19",
    "concurrently": "^9",
    "dotenv": "^17",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.5",
    "trigger.dev": "4.8.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "preserveUnused": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@depot/cli",
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  }
}
