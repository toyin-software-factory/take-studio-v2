# Copy to .env for local dev. Every variable the app or jobs read is listed here.
# Where each one lives in production: docs/specs/0001-stack-architecture/index.md, "Where each key lives".

# Database. Local values match docker-compose.yml.
# Jobs (Trigger.dev) use the Neon pooled URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/take_studio
# Migrations (drizzle-kit) use the Neon direct URL.
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/take_studio
# The web app reaches Postgres through the HYPERDRIVE binding (wrangler.jsonc).
# Locally that binding uses localConnectionString, or this override:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@localhost:5432/take_studio

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (S3 API credentials, one private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Trigger.dev (dev key locally, prod key on the Worker)
TRIGGER_SECRET_KEY=

# Usage accounting: HMAC secret for usage rows (any long random string, 32+ chars).
# Same value on the Worker and in Trigger.dev. Never change it once charges exist.
USAGE_HASH_SECRET=

# Sentry error monitoring (spec 0005). Optional: leave unset and Sentry stays off, locally
# and in CI. Production values live in the Worker secret, Trigger.dev env and GitHub secrets.
# SENTRY_DSN=                  (server and jobs)
# NEXT_PUBLIC_SENTRY_DSN=      (browser, inlined at build)
# SENTRY_AUTH_TOKEN=           (source map upload, CI only)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_CHECK_TOKEN=          (Worker secret: unlocks /api/sentry-check, the deliberate test error)

# Later slices
# DEEPGRAM_API_KEY=   (slice 2)
# ANTHROPIC_API_KEY=  (slice 5)
